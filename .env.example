# Copy to .env, in the folder you run obs-layout-firebot from, to override where the tools find Firebot and OBS for
# this machine. Every line is optional. Each one wins over the config's `firebot` and `obs` entries; variables already
# set in the shell win over this file.

# Firebot profile folder, where integrations.json (OBS connection), settings.json, and the scripts folder live.
# Default: the config's firebot.profile ("Main") under Firebot's data folder, e.g. %APPDATA%\Firebot\v5\profiles\Main
#FIREBOT_PROFILE_DIR=

# Firebot's local HTTP API, used by deploy. Default: the config's firebot.apiUrl, else http://localhost:7472/api/v1
#FIREBOT_API_URL=

# OBS scene collection file, edited by fades while OBS is closed. Default: the config's obs.sceneCollection
# ("Untitled") under OBS's data folder, e.g. %APPDATA%\obs-studio\basic\scenes\Untitled.json
#OBS_SCENE_COLLECTION=

# obs-websocket connection for the tools. Unset, the tools use the config's "obs" entry, then Firebot's OBS
# integration settings, then obs-websocket's own defaults of localhost:4455 with no password.
#OBS_WEBSOCKET_URL=ws://localhost:4455
#OBS_WEBSOCKET_PASSWORD=
