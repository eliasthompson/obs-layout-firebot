{
  "compilerOptions": {
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@eliasthompson/obs-layout-firebot": ["./src/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["config", "eslint.config.ts", "src", "tools", "tsdown.config.ts", "vitest.config.ts"]
}
