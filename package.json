{
  "name": "@eliasthompson/obs-layout-firebot",
  "version": "5.0.0",
  "description": "Firebot custom script and CLI that lay out OBS scene items with obs-layout-generator and the Move Transition plugin",
  "keywords": [
    "firebot",
    "layout",
    "move-transition",
    "obs",
    "obs-studio",
    "streaming"
  ],
  "homepage": "https://github.com/eliasthompson/obs-layout-firebot#readme",
  "bugs": {
    "url": "https://github.com/eliasthompson/obs-layout-firebot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliasthompson/obs-layout-firebot.git"
  },
  "license": "MIT",
  "author": "Elias Thompson",
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "bin": {
    "obs-layout-firebot": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eliasthompson/obs-layout-generator": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@eliasthompson/obs-layout-generator": "^4.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./settings": "./dist/settings.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
